@rendermode InteractiveServer
@implements IDisposable

@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D
@using System.Drawing
@using System.Diagnostics
@using CS3500.LogSupport
@using CS3500.Networking
@using Microsoft.Extensions.Logging.Abstractions
@using System.Net.Sockets
@using System.Text.Json

@inject IJSRuntime JsRuntime;
@inject ILogger<Program> Logger;

<PageTitle> Snake Game </PageTitle>

<h1>Snake Game</h1>

@{
    bool connected = server.IsConnected;

    string grayedOut1 = connected ? "grayedOut" : string.Empty;
}

<label for="userIdInput">User ID:</label>
<input type="text" id="userIdInput" class="@grayedOut1" disabled="@(connected)" @bind="userID" />
<div>&nbsp</div>
<label for="serverAddressInput">Server Address:</label>
<input type="text" id="serverAddressInput" @bind="serverAddress" />
<div>&nbsp</div>
<label for="portInput">Port:</label>
<input type="number" id="portInput" @bind="port" />
<div>&nbsp</div>
@if (!server.IsConnected)
{
    <button class="btn btn-primary" @onclick="Connect">Connect</button>
}

@if (server.IsConnected)
{
<button class="btn btn-danger" @onclick="Disconnect">Disconnect</button>
}

<div id="myCanvas">
    <BECanvas Width="800" Height="800" @ref="canvasReference" />
</div>

<img src="images/backgroundImage2.png" @ref="backgroundImage" style="display:none" />
<img src="images/wall.jpg" @ref="wallImage" style="display:none" />


@code
{
    // Drawing/Canvas variables here.
    private BECanvasComponent canvasReference = null!;
    private Canvas2DContext context = null!;

    // GUI Model here:
    private int GUIWidth = 800, GUIHeight = 800;
    private DateTime StartTime = DateTime.Now;
    private int frameNumberGUI = 0;
    private string errorMessage = string.Empty;
    private ILogger logger = null!;

    // Locked Object for Parallel programming.
    private List<Rectangle> worldModel = new();

    // Controller Model here:
    private IJSObjectReference _jsModule = null!;

    private NetworkConnection server;

    private string userID = "";

    /// <summary>
    /// Initializes a new instance of the <see cref="SnakeClient"/> class
    /// with a default <see cref="NetworkConnection"/> object.
    /// </summary>
    public SnakeClient()
    {
        server = new NetworkConnection();
    }

    /// <summary>
    /// Initializes a new instance of the <see cref="SnakeClient"/> class with the specified network connection.
    /// </summary>
    /// <param name="server">
    /// The <see cref="NetworkConnection"/> object that manages the connection to the server.
    /// </param>
    public SnakeClient(NetworkConnection server) => this.server = server;

    private string networkStatus = "Not Connected";
    private int frameNumberNetwork = 0;
    private DateTime ConnectTime = DateTime.Now;

    /// <summary>
    ///   First step in the Blazor Page Life Cycle.  In some circumstances
    ///   you would load data here.  We do not need to.
    /// </summary>
    protected override void OnInitialized()
    {
        logger = LogSupport<SnakeClient>.GetLogger();
        logger.LogDebug("Initialized");
    }

    /// <summary>
    /// Gets or sets the message displayed in the alert box on the UI.
    /// </summary>
    /// <value>
    /// A string representing the alert message to be displayed.
    /// </value>
    private string AlertMessage { get; set; } = "Welcome! This is a fancy snake game.";

    /// <summary>
    /// Updates the alert message displayed on the UI.
    /// </summary>
    /// <param name="newMessage">
    /// The new message to set as the alert.
    /// </param>
    public void UpdateAlert(string newMessage)
    {
        AlertMessage = newMessage;
    }

    /// <summary>
    ///   The first time we start up, we load our JavaScript and start the animation
    ///   process.
    /// </summary>
    /// <param name="firstRender"></param>
    /// <returns></returns>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            logger = LogSupport<SnakeClient>.GetLogger();
            logger.LogDebug("First Render");

            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Pages/SnakeClient.razor.js");
            context = await canvasReference.CreateCanvas2DAsync();

            await _jsModule.InvokeVoidAsync("initJS", DotNetObjectReference.Create(this));
            await _jsModule.InvokeVoidAsync("ToggleAnimation", true);

            // Wait for the image to load
            try
            {
                await JsRuntime.InvokeVoidAsync("blazorCanvas.waitForImageLoad", backgroundImage);
                logger.LogInformation("Background image loaded successfully.");
            }
            catch (Exception ex)
            {
                logger.LogError($"Error loading background image: {ex.Message}");
            }
        }
    }

    /// <summary>
    ///   Draw the world
    /// </summary>
    /// <param name="timeStamp">
    ///   Tells you how many milliseconds have
    ///   elapsed sense the web page was loaded.
    /// </param>
    [JSInvokable]
    public async void Draw(double timeStamp = 0)
    {
        frameNumberGUI++;

        double fps = frameNumberGUI / (DateTime.Now - StartTime).TotalSeconds;
        double nps = frameNumberNetwork > 0 ? frameNumberNetwork / (DateTime.Now - ConnectTime).TotalSeconds : 0;
        int timeInSeconds = (int)(DateTime.Now - StartTime).TotalSeconds;


        try
        {
            // Group all the draw commands into one large single draw.
            await context.BeginBatchAsync();

            await this.DrawBackGround();

            await this.DrawModel();

            // await this.DrawSomethingOnHead();

            await this.context.RestoreAsync();

            await this.DrawHUD(fps, nps, timeInSeconds);

            await this.context.EndBatchAsync();
        }
        catch (Exception e)
        {
            logger.LogDebug($"Error drawing: {e}");
        }
    }

    /// <summary>
    ///   <para>
    ///     This method is called from the JavaScript side of the
    ///     browser.
    ///   </para>
    ///   <remarks>
    ///      Must be PUBLIC for JavaScript to call!
    ///   </remarks>
    /// </summary>
    /// <param name="width"></param>
    /// <param name="height"></param>
    [JSInvokable]
    public void ResizeInBlazor(int width, int height)
    {
        logger.LogTrace("Resizing the web page. {width} {height}", width, height);
        GUIWidth = Math.Min(Math.Max(100, width), 1000);
        GUIHeight = Math.Min(Math.Max(100, height), 1000);
    }

    /// <summary>
    ///   Called by the system when the page is navigated away from.
    ///   Note: sometimes the debugger will create a "dummy" page when
    ///   first navigated to, then dispose it, then create the actual page.
    ///   You can ignore this behavior.
    /// </summary>
    public void Dispose()
    {
        _jsModule.InvokeVoidAsync("ToggleAnimation", false);
        logger.LogDebug("Dispose");
    }
}